{
  "name": "rbds-auth-login",
  "version": "1.0.0",
  "description": "A lib for handle authentication unified for rbds systems",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": ["./dist/index.css"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.mjs"
      },
      "require": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      }
    },
    "./auth-pkce": {
      "import": {
        "types": "./dist/auth-pkce.d.ts",
        "default": "./dist/auth-pkce.mjs"
      },
      "require": {
        "types": "./dist/auth-pkce.d.ts",
        "default": "./dist/auth-pkce.js"
      }
    },
    "./jwt": {
      "import": {
        "types": "./dist/jwt.d.ts",
        "default": "./dist/jwt.mjs"
      },
      "require": {
        "types": "./dist/jwt.d.ts",
        "default": "./dist/jwt.js"
      }
    },
    "./style.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "rbds",
    "auth",
    "login",
    "react"
  ],
  "author": "vitor-victor",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}